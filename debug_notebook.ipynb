    "## 🤖 Strategy Calculation Debug\n",
    "\n",
    "Test strategy signal generation with different data periods."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "y5z6a7b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize strategy with backtesting mode
",
    "data_feed = BitcoinDataFeed(config['data'])
",
    "strategy = BitcoinStrategy(config['strategy'], data_feed)
",
    "strategy.backtesting_mode = True
",
    "
",
    "# Test with a specific date range
",
    "start_date, end_date = '2025-06-01', '2025-06-30'
",
    "historical = data_feed.get_historical_data()
",
    "mask = (historical['timestamp'] >= start_date) & (historical['timestamp'] <= end_date)
",
    "period_data = historical.loc[mask]
",
    "
",
    "print(f'Testing period: {start_date} to {end_date}')
",
    "print(f'Data points: {len(period_data)}')
",
    "
",
    "# Test first 10 days
",
    "for i in range(min(10, len(period_data))):
",
    "    data_feed.current_price = period_data.iloc[i]['price']
",
    "    signal = strategy.calculate_signal()
",
    "    if signal:
",
    "        print(f'Day {i+1}: {signal.action} signal (confidence: {signal.confidence:.2f})')
",
    "    else:
",
    "        print(f'Day {i+1}: No signal')"
   ]
  },
